<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F6F8">

    <!-- App Title Header -->
    <TextView
        android:id="@+id/appTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROAD CONDITION DETECTOR"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/accelerometerXTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accelerometer X"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
        <TextView
            android:id="@+id/accelerometerYTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accelerometer Y"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#92990b" />
        <TextView
            android:id="@+id/accelerometerZTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accelerometer Z"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#73170a" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/latitudeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latitude"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
        <TextView
            android:id="@+id/longitudeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Longitude"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#92990b" />
        <TextView
            android:id="@+id/speedTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#73170a" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/gyroscopeXTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gyroscope X"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
        <TextView
            android:id="@+id/gyroscopeYTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gyroscope Y"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#92990b" />
        <TextView
            android:id="@+id/gyroscopeZTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gyroscope Z"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#73170a" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:weightSum="2">

        <Button
            android:id="@+id/ChangeThisIDOne"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.25"
            android:backgroundTint="#616161"
            android:text="TempButtonOne"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Gas Pedal (Increase Speed) -->
        <Button
            android:id="@+id/ChangeThisIDTwo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="0.75"
            android:backgroundTint="#424242"
            android:text="TempButtonTwo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
